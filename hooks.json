        "type": "command",
        "bash": "/Users/jaylee/.copilot/hooks/tool-guardian/guard-tool.sh",
        "cwd": ".",
        "env": {
          "GUARD_MODE": "block"
        },
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "/Users/jaylee/.copilot/hooks/uv-enforcer/uv-enforcer.sh",
        "cwd": ".",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "/Users/jaylee/.copilot/hooks/doc-file-warning/doc-file-warning.sh",
        "cwd": ".",
        "env": {
          "SKIP_DOC_FILE_WARNING": "false"
